#!/usr/bin/env python3
from __future__ import annotations

import base64
import json
import os
import re
import subprocess
import sys
from pathlib import Path


HOSTNAME_VARIABLES = (
    "RANCHER_HOSTNAME",
    "HARBOR_HOSTNAME",
    "PORTAINER_HOSTNAME",
)

JSON_SECRET_VARIABLES = (
    "RANCHER_BOOTSTRAP_PASSWORD",
)

BASE64_SECRET_VARIABLES = (
    "HARBOR_ADMIN_PASSWORD",
)


def die(message: str) -> None:
    print(f"ERROR: {message}", file=sys.stderr)
    raise SystemExit(1)


def validate_hostname(variable: str, value: str) -> None:
    labels = value.split(".")
    valid_label = re.compile(r"[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?")
    if len(value) > 253 or not labels or any(
        not valid_label.fullmatch(label) for label in labels
    ):
        die(f"{variable} must be a valid DNS hostname without a scheme or path.")


def configured_values() -> dict[str, str]:
    values = {}
    for variable in HOSTNAME_VARIABLES:
        value = os.environ.get(variable, "").strip()
        if not value:
            die(f"{variable} is not set. Source sysadmin-env before applying services.")
        validate_hostname(variable, value)
        values[variable] = value

    for variable in JSON_SECRET_VARIABLES:
        value = os.environ.get(variable, "")
        if not value:
            die(f"{variable} is not set. Source sysadmin-env before applying services.")
        if "\n" in value or "\r" in value:
            die(f"{variable} must not contain a newline.")
        # JSON strings are also valid YAML scalars and safely preserve special
        # characters when substituted into a Helm values document.
        values[f"{variable}_JSON"] = json.dumps(value)

    for variable in BASE64_SECRET_VARIABLES:
        value = os.environ.get(variable, "")
        if not value:
            die(f"{variable} is not set. Source sysadmin-env before applying services.")
        if "\n" in value or "\r" in value:
            die(f"{variable} must not contain a newline.")
        values[f"{variable}_B64"] = base64.b64encode(
            value.encode("utf-8")
        ).decode("ascii")

    return values


def run() -> None:
    values = configured_values()
    repository = Path(__file__).resolve().parent.parent
    services = repository / "sysadmin-services"

    try:
        result = subprocess.run(
            ["kubectl", "kustomize", str(services)],
            check=True,
            capture_output=True,
            text=True,
        )
    except FileNotFoundError:
        die("kubectl was not found in PATH.")
    except subprocess.CalledProcessError as exc:
        detail = (exc.stderr or exc.stdout or "unknown error").strip()
        die(f"Could not render sysadmin services: {detail}")

    rendered = result.stdout
    for variable, value in values.items():
        placeholder = "${" + variable + "}"
        if placeholder not in rendered:
            die(f"The rendered manifests do not contain {placeholder}.")
        rendered = rendered.replace(placeholder, value)

    unresolved = "${" in rendered
    if unresolved:
        die("The rendered manifests contain an unresolved environment placeholder.")

    try:
        subprocess.run(
            ["kubectl", "apply", "-f", "-"],
            check=True,
            input=rendered,
            text=True,
        )
    except FileNotFoundError:
        die("kubectl was not found in PATH.")
    except subprocess.CalledProcessError as exc:
        raise SystemExit(exc.returncode) from exc


if __name__ == "__main__":
    run()
