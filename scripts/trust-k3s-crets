#!/usr/bin/env python3
"""
trust-k3s-certs

Discover certificates used by K3s Ingress endpoints and install appropriate
self-signed/private CA certificates into:

  1. The Ubuntu system CA trust store
  2. Chromium's machine-wide CACertificates enterprise policy
  3. K3s containerd registry trust for every sysadmin-service Ingress
  4. The Argo server and Workflow Pods when Argo runs at ARGO_HOSTNAME

The script then copies the certificates and merged K3s registry configuration
to every Ready K3s node over SSH/SCP and restarts K3s on those nodes.

Discovery sources:
  * Ingress TLS Secrets (ca.crt / tls.crt)
  * The certificate chain actually served by every Ingress hostname on :443

Requirements:
  * Python 3
  * openssl
  * k3s or kubectl
  * update-ca-certificates
  * ssh and scp
  * PyYAML
"""

from __future__ import annotations

import argparse
import base64
import copy
import hashlib
import http.client
import json
import os
import pwd
import re
import shutil
import socket
import ssl
import subprocess
import sys
import tempfile
import time
from pathlib import Path

from config_env import ConfigError, load_sysadmin_env

TRUST_DIR = Path("/usr/local/share/ca-certificates/k3s")
CHROMIUM_POLICY_DIR = Path("/etc/chromium/policies/managed")
CHROMIUM_BROWSER_POLICY_DIR = Path("/etc/chromium-browser/policies/managed")
CHROME_POLICY_DIR = Path("/etc/opt/chrome/policies/managed")
POLICY_FILENAME = "k3s-trusted-cas.json"
K3S_CONFIG_DIR = Path("/etc/rancher/k3s")
K3S_REGISTRIES_PATH = K3S_CONFIG_DIR / "registries.yaml"
K3S_CA_BUNDLE_PATH = K3S_CONFIG_DIR / "sysadmin-services-ca-bundle.pem"
SYSTEM_CA_BUNDLE_PATH = Path("/etc/ssl/certs/ca-certificates.crt")
ARGO_CA_VOLUME_NAME = "k3s-sysadmin-ca-trust"
ARGO_CA_MOUNT_PATH = "/etc/ssl/certs/k3s-sysadmin-ca-bundle.pem"
ARGO_SERVER_CA_SECRET_NAME = "intermediate-ca"
ARGO_CA_ENVIRONMENT = (
    "SSL_CERT_FILE",
    "REQUESTS_CA_BUNDLE",
    "CURL_CA_BUNDLE",
    "GIT_SSL_CAINFO",
    "NODE_EXTRA_CA_CERTS",
    "AWS_CA_BUNDLE",
)

PEM_CERT_RE = re.compile(
    rb"-----BEGIN CERTIFICATE-----\s+.*?-----END CERTIFICATE-----",
    re.DOTALL,
)


class CommandError(RuntimeError):
    pass


def run(
    cmd: list[str],
    *,
    input_bytes: bytes | None = None,
    timeout: int | None = None,
    check: bool = True,
) -> subprocess.CompletedProcess:
    try:
        proc = subprocess.run(
            cmd,
            input=input_bytes,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=timeout,
        )
    except subprocess.TimeoutExpired as exc:
        raise CommandError(f"Command timed out: {' '.join(cmd)}") from exc

    if check and proc.returncode != 0:
        raise CommandError(
            f"Command failed ({proc.returncode}): {' '.join(cmd)}\n"
            f"{proc.stderr.decode(errors='replace').strip()}"
        )
    return proc


def choose_kubectl(explicit: str | None) -> list[str]:
    if explicit:
        return explicit.split()

    if shutil.which("k3s"):
        return ["k3s", "kubectl"]

    if shutil.which("kubectl"):
        return ["kubectl"]

    raise SystemExit("ERROR: neither 'k3s' nor 'kubectl' was found in PATH.")


def kubectl_json(kubectl: list[str], args: list[str]) -> dict:
    return json.loads(run(kubectl + args).stdout)


def validate_registry_host(host: str) -> str:
    if not re.fullmatch(
        r"[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?(?::[0-9]{1,5})?",
        host,
    ):
        raise CommandError(
            f"Invalid sysadmin-service hostname discovered from Ingress: {host!r}"
        )
    return host


def validate_ssh_user(username: str) -> str:
    if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_.-]*", username):
        raise CommandError(f"Invalid SSH username: {username!r}")
    return username


def validate_node_address(address: str) -> str:
    if not re.fullmatch(r"[A-Za-z0-9_.:-]+", address) or address.startswith("-"):
        raise CommandError(f"Invalid Kubernetes node address: {address!r}")
    return address


def split_pem_certificates(data: bytes) -> list[bytes]:
    return [m.group(0).strip() + b"\n" for m in PEM_CERT_RE.finditer(data)]


def fingerprint(cert: bytes) -> str:
    return hashlib.sha256(cert).hexdigest()


def sanitize(value: str) -> str:
    return re.sub(r"[^A-Za-z0-9_.-]+", "-", value)


def openssl_text(cert: bytes, args: list[str]) -> str:
    with tempfile.NamedTemporaryFile(suffix=".crt") as tmp:
        tmp.write(cert)
        tmp.flush()
        out = run(["openssl", "x509", "-in", tmp.name, "-noout"] + args).stdout
    return out.decode(errors="replace").strip()


def cert_subject(cert: bytes) -> str:
    return openssl_text(cert, ["-subject"]).removeprefix("subject=").strip()


def cert_issuer(cert: bytes) -> str:
    return openssl_text(cert, ["-issuer"]).removeprefix("issuer=").strip()


def cert_dates(cert: bytes) -> str:
    try:
        return openssl_text(cert, ["-dates"]).replace("\n", ", ")
    except CommandError:
        return ""


def is_self_signed(cert: bytes) -> bool:
    try:
        if cert_subject(cert) != cert_issuer(cert):
            return False

        with tempfile.NamedTemporaryFile(suffix=".crt") as tmp:
            tmp.write(cert)
            tmp.flush()
            proc = subprocess.run(
                ["openssl", "verify", "-CAfile", tmp.name, tmp.name],
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
            )
        return proc.returncode == 0
    except (CommandError, OSError):
        return False


def is_ca(cert: bytes) -> bool:
    try:
        text = openssl_text(cert, ["-text"])
        return "CA:TRUE" in text
    except CommandError:
        return False


def pem_to_der_b64(cert: bytes) -> str:
    pem_text = cert.decode("ascii")
    der = ssl.PEM_cert_to_DER_cert(pem_text)
    return base64.b64encode(der).decode("ascii")


def fetch_endpoint_chain(host: str, port: int = 443) -> list[bytes]:
    """
    Fetch the TLS chain exactly as served to clients.

    openssl s_client commonly exits 0 even when verification fails, which is
    useful here because discovery must work before the CA is trusted.
    """
    cmd = [
        "openssl",
        "s_client",
        "-connect",
        f"{host}:{port}",
        "-servername",
        host,
        "-showcerts",
    ]

    try:
        proc = subprocess.run(
            cmd,
            input=b"",
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            timeout=8,
        )
    except subprocess.TimeoutExpired:
        return []

    return split_pem_certificates(proc.stdout)


def choose_trust_chain(certs: list[bytes]) -> list[bytes]:
    """
    Return every CA certificate required to build the local chain.

    Keep intermediates as well as self-signed roots. Some clients can retrieve
    missing intermediates, but Argo must not depend on that behavior for local
    services. A self-signed leaf (common for internal services) is also a valid
    local trust anchor even when it does not advertise CA:TRUE.
    """
    chain = [cert for cert in certs if is_ca(cert)]
    seen = {fingerprint(cert) for cert in chain}
    chain.extend(
        cert
        for cert in certs
        if is_self_signed(cert) and fingerprint(cert) not in seen
    )
    return chain


def candidate_from_secret(secret: dict) -> tuple[list[bytes], str]:
    data = secret.get("data") or {}
    chain: list[bytes] = []
    sources = []

    ca_b64 = data.get("ca.crt")
    if ca_b64:
        decoded = base64.b64decode(ca_b64)
        certs = split_pem_certificates(decoded)
        if certs:
            # ca.crt is explicitly a CA chain. Preserve every certificate so
            # an intermediate is not discarded when the root is also present.
            chain.extend(certs)
            sources.append("ca.crt")

    tls_b64 = data.get("tls.crt")
    if tls_b64:
        decoded = base64.b64decode(tls_b64)
        certs = split_pem_certificates(decoded)
        tls_chain = choose_trust_chain(certs)
        if tls_chain:
            chain.extend(tls_chain)
            sources.append("tls.crt")

    if chain:
        unique_chain = []
        seen = set()
        for cert in chain:
            fp = fingerprint(cert)
            if fp not in seen:
                seen.add(fp)
                unique_chain.append(cert)
        return unique_chain, f"complete CA chain from secret {' + '.join(sources)}"

    return [], "no usable trust anchor in Secret"


def discover_ingresses(
    kubectl: list[str],
    namespaces: set[str] | None,
) -> list[dict]:
    obj = kubectl_json(
        kubectl,
        ["get", "ingress", "--all-namespaces", "-o", "json"],
    )

    results = []
    for ingress in obj.get("items", []):
        metadata = ingress["metadata"]
        namespace = metadata["namespace"]

        if namespaces and namespace not in namespaces:
            continue

        name = metadata["name"]
        spec = ingress.get("spec") or {}

        hosts = set()
        backend_services = set()
        for rule in spec.get("rules", []) or []:
            host = rule.get("host")
            if host:
                hosts.add(host)
            http = rule.get("http") or {}
            for path in http.get("paths", []) or []:
                service = ((path.get("backend") or {}).get("service") or {})
                service_name = service.get("name")
                if service_name:
                    backend_services.add(service_name)

        default_service = ((spec.get("defaultBackend") or {}).get("service") or {})
        if default_service.get("name"):
            backend_services.add(default_service["name"])

        secrets: dict[str, set[str]] = {}
        for tls in spec.get("tls", []) or []:
            tls_hosts = set(tls.get("hosts") or [])
            hosts.update(tls_hosts)

            secret = tls.get("secretName")
            if secret:
                secrets.setdefault(secret, set()).update(tls_hosts)

        results.append(
            {
                "namespace": namespace,
                "name": name,
                "labels": metadata.get("labels") or {},
                "hosts": sorted(hosts),
                "secrets": secrets,
                "backend_services": sorted(backend_services),
            }
        )

    return results


def discover_sysadmin_registry_hosts(
    ingresses: list[dict],
    explicit: list[str],
) -> list[str]:
    hosts = {
        validate_registry_host(host)
        for ingress in ingresses
        if ingress["namespace"] == "sysadmin-system"
        for host in ingress["hosts"]
    }
    hosts.update(validate_registry_host(host) for host in explicit)
    if not hosts:
        raise CommandError(
            "Could not discover any sysadmin-service hostnames from Ingress "
            "resources in namespace 'sysadmin-system'. Ensure the services are "
            "deployed, or pass --registry-host for an additional hostname."
        )
    return sorted(hosts)


def configured_argo_hostname() -> str | None:
    """Load the optional Argo hostname from the administrator configuration."""
    try:
        load_sysadmin_env()
    except ConfigError as exc:
        print(f"WARNING: cannot read ARGO_HOSTNAME: {exc}")
        return None

    hostname = os.environ.get("ARGO_HOSTNAME", "").strip()
    if not hostname:
        return None
    valid_label = re.compile(
        r"[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?"
    )
    labels = hostname.split(".")
    if (
        len(hostname) > 253
        or not labels
        or any(not valid_label.fullmatch(label) for label in labels)
    ):
        print(
            "WARNING: ARGO_HOSTNAME must be a DNS hostname without a scheme, "
            f"port, or path; skipping Argo trust injection: {hostname!r}"
        )
        return None
    return hostname


def argo_ingress_namespaces(ingresses: list[dict], hostname: str) -> set[str]:
    """Return namespaces with an Ingress that serves ARGO_HOSTNAME."""
    return {
        ingress["namespace"]
        for ingress in ingresses
        if hostname in ingress["hosts"]
    }


def argo_ca_secret_data(certs: list[bytes]) -> dict[str, str]:
    """Build root and intermediate Secret files from the complete CA chain."""
    roots = []
    intermediates = []
    for cert in certs:
        if is_self_signed(cert):
            roots.append(cert)
        else:
            intermediates.append(cert)

    data = {}
    if roots:
        root_chain = b"".join(cert.rstrip() + b"\n" for cert in roots)
        data["root-ca.crt"] = base64.b64encode(root_chain).decode("ascii")
    if intermediates:
        intermediate_chain = b"".join(
            cert.rstrip() + b"\n" for cert in intermediates
        )
        data["intermediate-ca.crt"] = base64.b64encode(
            intermediate_chain
        ).decode("ascii")
    return data


def sync_argo_ca_secret(
    kubectl: list[str],
    namespace: str,
    certs: list[bytes],
) -> bool:
    """Create or replace Argo's mounted CA Secret with the complete chain."""
    desired_data = argo_ca_secret_data(certs)
    if not desired_data:
        raise CommandError("No certificates are available for the Argo CA Secret.")

    result = run(
        kubectl
        + [
            "get",
            "secret",
            ARGO_SERVER_CA_SECRET_NAME,
            "-n",
            namespace,
            "--ignore-not-found",
            "-o",
            "json",
        ]
    )
    if result.stdout.strip():
        try:
            existing = json.loads(result.stdout)
        except json.JSONDecodeError as exc:
            raise CommandError(
                f"Could not parse Argo CA Secret {namespace}/"
                f"{ARGO_SERVER_CA_SECRET_NAME}: {exc}"
            ) from exc
        if (existing.get("data") or {}) == desired_data:
            print(
                f"Argo trust: Secret {namespace}/"
                f"{ARGO_SERVER_CA_SECRET_NAME} already contains the full chain."
            )
            return False

        # JSON Patch 'add' replaces an existing object member and also works
        # when data is absent. Replacing the whole map removes stale certs.
        patch = json.dumps(
            [{"op": "add", "path": "/data", "value": desired_data}]
        )
        run(
            kubectl
            + [
                "patch",
                "secret",
                ARGO_SERVER_CA_SECRET_NAME,
                "-n",
                namespace,
                "--type=json",
                "-p",
                patch,
            ]
        )
        print(
            f"Argo trust: updated Secret {namespace}/"
            f"{ARGO_SERVER_CA_SECRET_NAME} with the full chain."
        )
        return True

    secret = {
        "apiVersion": "v1",
        "kind": "Secret",
        "metadata": {
            "name": ARGO_SERVER_CA_SECRET_NAME,
            "namespace": namespace,
            "labels": {"app.kubernetes.io/part-of": "sysadmin-system"},
        },
        "data": desired_data,
        "type": "Opaque",
    }
    run(
        kubectl + ["create", "-f", "-"],
        input_bytes=json.dumps(secret).encode("utf-8"),
    )
    print(
        f"Argo trust: created Secret {namespace}/"
        f"{ARGO_SERVER_CA_SECRET_NAME} with the full chain."
    )
    return True


def restart_argo_servers(kubectl: list[str], namespaces: set[str]) -> None:
    """Restart Argo servers so their Go TLS trust pools load the new Secret."""
    deployments = kubectl_json(
        kubectl,
        ["get", "deployment", "--all-namespaces", "-o", "json"],
    )
    restarted = 0
    for deployment in deployments.get("items", []):
        metadata = deployment.get("metadata") or {}
        namespace = metadata.get("namespace")
        name = metadata.get("name")
        if namespace not in namespaces or not name:
            continue

        containers = (
            (((deployment.get("spec") or {}).get("template") or {}).get("spec") or {})
            .get("containers", [])
        )
        is_server = any(
            container.get("name") == "argo-server"
            or (
                "/argocli:" in container.get("image", "")
                and "server" in (container.get("args") or [])
            )
            for container in containers
        )
        if not is_server:
            continue

        run(
            kubectl
            + [
                "rollout",
                "restart",
                f"deployment/{name}",
                "-n",
                namespace,
            ]
        )
        print(f"Argo trust: restarted Deployment {namespace}/{name}.")
        restarted += 1

    if restarted == 0:
        print(
            "Argo trust: the CA Secret changed, but no Argo server Deployment "
            "was found to restart."
        )


def argo_endpoint_status(hostname: str) -> int:
    """Return an HTTPS status code only when ARGO_HOSTNAME is TLS-reachable."""
    if not SYSTEM_CA_BUNDLE_PATH.is_file():
        raise CommandError(
            f"System CA bundle does not exist: {SYSTEM_CA_BUNDLE_PATH}"
        )

    context = ssl.create_default_context(cafile=str(SYSTEM_CA_BUNDLE_PATH))
    connection = http.client.HTTPSConnection(
        hostname,
        443,
        timeout=8,
        context=context,
    )
    try:
        connection.request(
            "GET",
            "/",
            headers={"User-Agent": "k3s-turing-pi-trust-certs/1"},
        )
        response = connection.getresponse()
        response.read(1)
        return response.status
    except (OSError, http.client.HTTPException, ssl.SSLError) as exc:
        raise CommandError(
            f"https://{hostname}/ is not reachable with trusted TLS: {exc}"
        ) from exc
    finally:
        connection.close()


def workflow_controller_deployment(
    kubectl: list[str], namespaces: set[str]
) -> dict | None:
    deployments = kubectl_json(
        kubectl,
        ["get", "deployment", "--all-namespaces", "-o", "json"],
    )
    for deployment in deployments.get("items", []):
        metadata = deployment.get("metadata") or {}
        if metadata.get("namespace") not in namespaces:
            continue

        containers = (
            (((deployment.get("spec") or {}).get("template") or {}).get("spec") or {})
            .get("containers", [])
        )
        is_controller = any(
            container.get("name") == "workflow-controller"
            or "/workflow-controller:" in container.get("image", "")
            for container in containers
        )
        ready_replicas = (deployment.get("status") or {}).get("readyReplicas", 0)
        if is_controller and ready_replicas > 0:
            return deployment
    return None


def controller_configmap_name(deployment: dict) -> str:
    metadata = deployment.get("metadata") or {}
    deployment_name = metadata.get("name", "")
    containers = (
        (((deployment.get("spec") or {}).get("template") or {}).get("spec") or {})
        .get("containers", [])
    )
    controller = next(
        (
            container
            for container in containers
            if container.get("name") == "workflow-controller"
            or "/workflow-controller:" in container.get("image", "")
        ),
        None,
    )
    if controller:
        args = controller.get("args") or []
        for index, argument in enumerate(args):
            if argument == "--configmap" and index + 1 < len(args):
                return args[index + 1]
            if argument.startswith("--configmap="):
                return argument.split("=", 1)[1]

    if deployment_name:
        return f"{deployment_name}-configmap"
    raise CommandError("Argo workflow controller Deployment has no name.")


def merge_named_items(
    existing: object,
    desired: list[dict],
    *,
    field: str,
) -> list[dict]:
    """Merge Kubernetes list entries by name while preserving unrelated entries."""
    if existing is None:
        items: list[dict] = []
    elif isinstance(existing, list) and all(isinstance(item, dict) for item in existing):
        items = copy.deepcopy(existing)
    else:
        raise CommandError(
            f"Argo workflowDefaults podSpecPatch '{field}' must be a list."
        )

    positions = {
        item.get("name"): index
        for index, item in enumerate(items)
        if item.get("name")
    }
    for desired_item in desired:
        name = desired_item["name"]
        if name in positions:
            items[positions[name]].update(copy.deepcopy(desired_item))
        else:
            positions[name] = len(items)
            items.append(copy.deepcopy(desired_item))
    return items


def render_argo_workflow_defaults(current: str) -> str:
    """Add the system CA bundle to Argo's default main-container Pod patch."""
    try:
        import yaml
    except ImportError as exc:
        raise CommandError(
            "Python package 'yaml' is required to configure Argo workflow trust. "
            "Install it with: sudo apt install python3-yaml"
        ) from exc

    try:
        defaults = yaml.safe_load(current) if current.strip() else {}
    except yaml.YAMLError as exc:
        raise CommandError(f"Could not parse Argo workflowDefaults: {exc}") from exc
    if defaults is None:
        defaults = {}
    if not isinstance(defaults, dict):
        raise CommandError("Argo workflowDefaults must contain a YAML mapping.")

    spec = defaults.setdefault("spec", {})
    if not isinstance(spec, dict):
        raise CommandError("Argo workflowDefaults 'spec' must be a YAML mapping.")

    current_patch = spec.get("podSpecPatch", "")
    if current_patch is None:
        current_patch = ""
    if not isinstance(current_patch, str):
        raise CommandError("Argo workflowDefaults 'podSpecPatch' must be a string.")
    try:
        pod_patch = yaml.safe_load(current_patch) if current_patch.strip() else {}
    except yaml.YAMLError as exc:
        raise CommandError(
            f"Could not parse Argo workflowDefaults podSpecPatch: {exc}"
        ) from exc
    if pod_patch is None:
        pod_patch = {}
    if not isinstance(pod_patch, dict):
        raise CommandError("Argo workflowDefaults podSpecPatch must be a YAML mapping.")

    class LiteralString(str):
        pass

    class LiteralSafeDumper(yaml.SafeDumper):
        pass

    LiteralSafeDumper.add_representer(
        LiteralString,
        lambda dumper, value: dumper.represent_scalar(
            "tag:yaml.org,2002:str", value, style="|"
        ),
    )

    pod_patch["volumes"] = merge_named_items(
        pod_patch.get("volumes"),
        [
            {
                "name": ARGO_CA_VOLUME_NAME,
                "hostPath": {
                    "path": str(SYSTEM_CA_BUNDLE_PATH),
                    "type": "File",
                },
            }
        ],
        field="volumes",
    )

    containers = merge_named_items(
        pod_patch.get("containers"),
        [{"name": "main"}],
        field="containers",
    )
    main = next(container for container in containers if container.get("name") == "main")
    main["volumeMounts"] = merge_named_items(
        main.get("volumeMounts"),
        [
            {
                "name": ARGO_CA_VOLUME_NAME,
                "mountPath": ARGO_CA_MOUNT_PATH,
                "readOnly": True,
            }
        ],
        field="containers[name=main].volumeMounts",
    )
    main["env"] = merge_named_items(
        main.get("env"),
        [
            {"name": variable, "value": ARGO_CA_MOUNT_PATH}
            for variable in ARGO_CA_ENVIRONMENT
        ],
        field="containers[name=main].env",
    )
    pod_patch["containers"] = containers
    spec["podSpecPatch"] = LiteralString(
        yaml.safe_dump(
            pod_patch,
            default_flow_style=False,
            sort_keys=False,
        )
    )
    return yaml.dump(
        defaults,
        Dumper=LiteralSafeDumper,
        default_flow_style=False,
        sort_keys=False,
    )


def render_argo_controller_config(current: str) -> str:
    """Merge workflow trust into the Helm chart's data.config document."""
    try:
        import yaml
    except ImportError as exc:
        raise CommandError(
            "Python package 'yaml' is required to configure Argo workflow trust. "
            "Install it with: sudo apt install python3-yaml"
        ) from exc

    try:
        controller_config = yaml.safe_load(current) if current.strip() else {}
    except yaml.YAMLError as exc:
        raise CommandError(f"Could not parse Argo controller config: {exc}") from exc
    if controller_config is None:
        controller_config = {}
    if not isinstance(controller_config, dict):
        raise CommandError("Argo controller config must contain a YAML mapping.")

    workflow_defaults = controller_config.get("workflowDefaults") or {}
    if not isinstance(workflow_defaults, dict):
        raise CommandError("Argo controller 'workflowDefaults' must be a YAML mapping.")
    rendered_defaults = render_argo_workflow_defaults(
        yaml.safe_dump(
            workflow_defaults,
            default_flow_style=False,
            sort_keys=False,
        )
    )
    controller_config["workflowDefaults"] = yaml.safe_load(rendered_defaults)

    class LiteralString(str):
        pass

    class LiteralSafeDumper(yaml.SafeDumper):
        pass

    LiteralSafeDumper.add_representer(
        LiteralString,
        lambda dumper, value: dumper.represent_scalar(
            "tag:yaml.org,2002:str", value, style="|"
        ),
    )
    workflow_spec = controller_config["workflowDefaults"]["spec"]
    workflow_spec["podSpecPatch"] = LiteralString(workflow_spec["podSpecPatch"])
    return yaml.dump(
        controller_config,
        Dumper=LiteralSafeDumper,
        default_flow_style=False,
        sort_keys=False,
    )


def inject_argo_workflow_trust(
    kubectl: list[str],
    ingresses: list[dict],
    hostname: str,
    certs: list[bytes],
) -> tuple[str, str] | None:
    namespaces = argo_ingress_namespaces(ingresses, hostname)
    if not namespaces:
        print(
            f"Argo trust: no Ingress serves ARGO_HOSTNAME ({hostname}); skipping."
        )
        return None

    changed_namespaces = {
        namespace
        for namespace in sorted(namespaces)
        if sync_argo_ca_secret(kubectl, namespace, certs)
    }
    if changed_namespaces:
        restart_argo_servers(kubectl, changed_namespaces)

    try:
        status = argo_endpoint_status(hostname)
    except CommandError as exc:
        print(f"Argo trust: {exc}; skipping.")
        return None

    deployment = workflow_controller_deployment(kubectl, namespaces)
    if deployment is None:
        print(
            "Argo trust: HTTPS responded, but no Ready workflow controller was "
            "found in the Ingress namespace; skipping."
        )
        return None

    metadata = deployment.get("metadata") or {}
    namespace = metadata["namespace"]
    configmap_name = controller_configmap_name(deployment)
    try:
        configmap = kubectl_json(
            kubectl,
            ["get", "configmap", configmap_name, "-n", namespace, "-o", "json"],
        )
    except (CommandError, json.JSONDecodeError) as exc:
        raise CommandError(
            f"Could not read Argo controller ConfigMap "
            f"{namespace}/{configmap_name}: {exc}"
        ) from exc

    data = configmap.get("data") or {}
    if "config" in data:
        data_key = "config"
        rendered = render_argo_controller_config(data.get(data_key, ""))
    else:
        # Upstream manifests commonly store this setting as its own data key.
        data_key = "workflowDefaults"
        rendered = render_argo_workflow_defaults(data.get(data_key, ""))
    if data.get(data_key) == rendered:
        print(
            f"Argo trust: https://{hostname}/ responded with HTTP {status}; "
            f"{namespace}/{configmap_name} is already configured."
        )
        return namespace, configmap_name

    patch = json.dumps({"data": {data_key: rendered}})
    run(
        kubectl
        + [
            "patch",
            "configmap",
            configmap_name,
            "-n",
            namespace,
            "--type=merge",
            "-p",
            patch,
        ]
    )
    print(
        f"Argo trust: https://{hostname}/ responded with HTTP {status}; updated "
        f"{namespace}/{configmap_name}."
    )
    return namespace, configmap_name


def ready_k3s_nodes(kubectl: list[str]) -> list[dict[str, str]]:
    obj = kubectl_json(kubectl, ["get", "nodes", "-o", "json"])
    nodes = []
    for node in obj.get("items", []):
        conditions = (node.get("status") or {}).get("conditions") or []
        if not any(
            condition.get("type") == "Ready" and condition.get("status") == "True"
            for condition in conditions
        ):
            continue

        metadata = node.get("metadata") or {}
        name = metadata.get("name")
        if not name:
            continue
        addresses = (node.get("status") or {}).get("addresses") or []
        address = None
        for address_type in ("InternalIP", "ExternalIP", "Hostname"):
            address = next(
                (
                    item.get("address")
                    for item in addresses
                    if item.get("type") == address_type and item.get("address")
                ),
                None,
            )
            if address:
                break
        if not address:
            raise CommandError(f"Ready node {name!r} has no usable address.")

        labels = metadata.get("labels") or {}
        is_server = any(
            role in labels
            for role in (
                "node-role.kubernetes.io/control-plane",
                "node-role.kubernetes.io/master",
                "node-role.kubernetes.io/etcd",
            )
        )
        nodes.append(
            {
                "name": name,
                "address": validate_node_address(address),
                "service": "k3s" if is_server else "k3s-agent",
            }
        )

    if not nodes:
        raise CommandError("No Ready K3s nodes were found.")
    return nodes


def write_cert(source_id: str, cert: bytes) -> Path:
    TRUST_DIR.mkdir(parents=True, exist_ok=True)

    path = TRUST_DIR / f"{sanitize(source_id)}.crt"
    current = path.read_bytes() if path.exists() else None

    if current != cert:
        path.write_bytes(cert)
        os.chmod(path, 0o644)

    return path


def all_managed_certs() -> list[bytes]:
    certs: list[bytes] = []
    seen: set[str] = set()

    if not TRUST_DIR.exists():
        return certs

    for path in sorted(TRUST_DIR.glob("*.crt")):
        for cert in split_pem_certificates(path.read_bytes()):
            fp = fingerprint(cert)
            if fp in seen:
                continue
            seen.add(fp)
            certs.append(cert)

    return certs


def atomic_write(path: Path, data: bytes, mode: int) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(dir=path.parent, delete=False) as tmp:
        temporary_path = Path(tmp.name)
        tmp.write(data)
        tmp.flush()
        os.fsync(tmp.fileno())
    try:
        os.chmod(temporary_path, mode)
        os.replace(temporary_path, path)
    finally:
        temporary_path.unlink(missing_ok=True)


def write_ca_bundle(certs: list[bytes]) -> Path:
    bundle = b"".join(cert.rstrip() + b"\n" for cert in certs)
    current = K3S_CA_BUNDLE_PATH.read_bytes() if K3S_CA_BUNDLE_PATH.exists() else None
    if current != bundle:
        atomic_write(K3S_CA_BUNDLE_PATH, bundle, 0o644)
    return K3S_CA_BUNDLE_PATH


def merge_k3s_registry_config(registry_hosts: list[str]) -> tuple[Path, Path | None]:
    try:
        import yaml
    except ImportError as exc:
        raise CommandError(
            "Python package 'yaml' is required to preserve existing K3s registry "
            "configuration. Install it with: sudo apt install python3-yaml"
        ) from exc

    existing_bytes = (
        K3S_REGISTRIES_PATH.read_bytes() if K3S_REGISTRIES_PATH.exists() else b""
    )
    try:
        existing = yaml.safe_load(existing_bytes) if existing_bytes.strip() else {}
    except yaml.YAMLError as exc:
        raise CommandError(f"Could not parse {K3S_REGISTRIES_PATH}: {exc}") from exc
    if not isinstance(existing, dict):
        raise CommandError(f"{K3S_REGISTRIES_PATH} must contain a YAML mapping.")

    merged = copy.deepcopy(existing)
    configs = merged.setdefault("configs", {})
    if not isinstance(configs, dict):
        raise CommandError(f"{K3S_REGISTRIES_PATH}: 'configs' must be a mapping.")
    for registry_host in registry_hosts:
        registry = configs.setdefault(registry_host, {})
        if not isinstance(registry, dict):
            raise CommandError(
                f"{K3S_REGISTRIES_PATH}: config for {registry_host!r} must be a mapping."
            )
        tls = registry.setdefault("tls", {})
        if not isinstance(tls, dict):
            raise CommandError(
                f"{K3S_REGISTRIES_PATH}: TLS config for {registry_host!r} must be a mapping."
            )
        tls["ca_file"] = str(K3S_CA_BUNDLE_PATH)

    rendered = yaml.safe_dump(merged, default_flow_style=False, sort_keys=False).encode()
    backup = None
    if rendered != existing_bytes:
        if K3S_REGISTRIES_PATH.exists():
            backup = K3S_REGISTRIES_PATH.with_name(
                f"{K3S_REGISTRIES_PATH.name}.bak.{time.strftime('%Y%m%d%H%M%S')}"
            )
            shutil.copy2(K3S_REGISTRIES_PATH, backup)
            os.chmod(backup, 0o600)
        atomic_write(K3S_REGISTRIES_PATH, rendered, 0o600)

    return K3S_REGISTRIES_PATH, backup


def local_node_names() -> set[str]:
    names = {socket.gethostname(), socket.getfqdn()}
    names.update(name.split(".", 1)[0] for name in list(names))
    return {name for name in names if name}


def ssh_client_prefix() -> list[str]:
    sudo_user = os.environ.get("SUDO_USER")
    if not sudo_user or sudo_user == "root":
        return []
    try:
        pwd.getpwnam(sudo_user)
    except KeyError as exc:
        raise CommandError(f"SUDO_USER account does not exist: {sudo_user!r}") from exc
    if not shutil.which("runuser"):
        raise CommandError("runuser is required to use the invoking user's SSH keys.")
    return ["runuser", "-u", sudo_user, "--"]


def ssh_destination(username: str, address: str, *, scp: bool = False) -> str:
    formatted = f"[{address}]" if scp and ":" in address else address
    return f"{username}@{formatted}"


def distribute_to_ready_nodes(
    nodes: list[dict[str, str]],
    ssh_user: str,
    registry_path: Path,
    bundle_path: Path,
) -> int:
    prefix = ssh_client_prefix()
    ssh_options = ["-o", "BatchMode=yes", "-o", "ConnectTimeout=10"]
    local_names = local_node_names()
    local_uid = None
    sudo_user = os.environ.get("SUDO_USER")
    if prefix and sudo_user:
        local_uid = pwd.getpwnam(sudo_user).pw_uid
        local_gid = pwd.getpwnam(sudo_user).pw_gid

    trust_files = sorted(TRUST_DIR.glob("*.crt"))
    if not trust_files:
        raise CommandError(f"No certificate files were found in {TRUST_DIR}.")

    distributed = 0
    with tempfile.TemporaryDirectory(prefix="k3s-turing-pi-trust-") as staging_name:
        staging = Path(staging_name)
        staged_files = []
        for source in [*trust_files, bundle_path, registry_path]:
            destination = staging / source.name
            shutil.copy2(source, destination)
            os.chmod(destination, 0o600)
            staged_files.append(destination)

        if local_uid is not None:
            os.chown(staging, local_uid, local_gid)
            for path in staged_files:
                os.chown(path, local_uid, local_gid)

        for node in nodes:
            if node["name"] in local_names or node["name"].split(".", 1)[0] in local_names:
                print(f"  {node['name']}: configured locally")
                continue

            target = ssh_destination(ssh_user, node["address"])
            scp_target = ssh_destination(ssh_user, node["address"], scp=True)
            remote_dir = f"/tmp/k3s-turing-pi-trust-{os.getpid()}"
            print(f"  {node['name']} ({node['address']}): copying trust configuration")
            try:
                run(
                    prefix
                    + ["ssh", *ssh_options, target, "mkdir", "-m", "700", remote_dir],
                    timeout=20,
                )
                run(
                    prefix
                    + [
                        "scp",
                        *ssh_options,
                        *[str(path) for path in staged_files],
                        f"{scp_target}:{remote_dir}/",
                    ],
                    timeout=60,
                )
                run(
                    prefix
                    + [
                        "ssh", *ssh_options, target,
                        "sudo", "-n", "install", "-d", "-o", "root", "-g", "root",
                        "-m", "0755", str(TRUST_DIR), str(K3S_CONFIG_DIR),
                    ],
                    timeout=20,
                )
                run(
                    prefix
                    + [
                        "ssh", *ssh_options, target,
                        "sudo", "-n", "install", "-o", "root", "-g", "root",
                        "-m", "0644",
                        *[f"{remote_dir}/{path.name}" for path in staged_files if path.suffix == ".crt"],
                        str(TRUST_DIR),
                    ],
                    timeout=30,
                )
                run(
                    prefix
                    + [
                        "ssh", *ssh_options, target,
                        "sudo", "-n", "install", "-o", "root", "-g", "root",
                        "-m", "0644", f"{remote_dir}/{bundle_path.name}",
                        str(K3S_CA_BUNDLE_PATH),
                    ],
                    timeout=20,
                )
                run(
                    prefix
                    + [
                        "ssh", *ssh_options, target,
                        "sudo", "-n", "install", "--backup=numbered",
                        "-o", "root", "-g", "root", "-m", "0600",
                        f"{remote_dir}/{registry_path.name}", str(K3S_REGISTRIES_PATH),
                    ],
                    timeout=20,
                )
                run(
                    prefix
                    + ["ssh", *ssh_options, target, "sudo", "-n", "update-ca-certificates"],
                    timeout=120,
                )
                run(
                    prefix
                    + [
                        "ssh", *ssh_options, target,
                        "sudo", "-n", "systemctl", "restart", node["service"],
                    ],
                    timeout=120,
                )
                distributed += 1
            finally:
                run(
                    prefix
                    + ["ssh", *ssh_options, target, "rm", "-rf", remote_dir],
                    timeout=20,
                    check=False,
                )
    return distributed


def restart_local_k3s() -> str | None:
    for service in ("k3s", "k3s-agent"):
        result = run(
            ["systemctl", "show", "--property=LoadState", "--value", service],
            check=False,
        )
        if result.returncode == 0 and result.stdout.strip() not in (b"", b"not-found"):
            run(["systemctl", "restart", service], timeout=120)
            return service
    return None


def chromium_policy_dirs() -> list[Path]:
    """
    Return Chromium's machine-wide policy paths.

    Ubuntu's chromium-browser package uses a different path from other
    Chromium builds. Always include both paths so write_chromium_policy() can
    create the required directory when it does not exist yet. Google Chrome is
    supported when installed as well.
    """
    dirs = [CHROMIUM_POLICY_DIR, CHROMIUM_BROWSER_POLICY_DIR]

    if shutil.which("google-chrome") or shutil.which("google-chrome-stable"):
        dirs.append(CHROME_POLICY_DIR)

    # Remove duplicates while preserving order.
    unique = []
    seen = set()
    for path in dirs:
        if str(path) not in seen:
            seen.add(str(path))
            unique.append(path)
    return unique


def write_chromium_policy(certs: list[bytes]) -> list[Path]:
    values = sorted({pem_to_der_b64(cert) for cert in certs})
    payload = {
        "CACertificates": values,
    }

    written = []
    for directory in chromium_policy_dirs():
        directory.mkdir(parents=True, exist_ok=True)
        os.chmod(directory, 0o755)

        path = directory / POLICY_FILENAME
        path.write_text(json.dumps(payload, indent=2) + "\n", encoding="utf-8")
        os.chmod(path, 0o644)
        written.append(path)

    return written


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Trust private/self-signed certificates used by K3s Ingress "
            "endpoints system-wide and inject them into Argo Workflows."
        )
    )
    parser.add_argument(
        "-n",
        "--namespace",
        action="append",
        default=[],
        help="Only inspect this namespace. May be specified multiple times.",
    )
    parser.add_argument(
        "--kubectl",
        help="kubectl command to use, e.g. 'k3s kubectl' or 'kubectl'.",
    )
    parser.add_argument(
        "--registry-host",
        action="append",
        default=[],
        help=(
            "Additional hostname to configure with the sysadmin-services CA "
            "bundle. May be specified more than once; deployed sysadmin-system "
            "Ingress hosts are discovered automatically."
        ),
    )
    parser.add_argument(
        "--ssh-user",
        help=(
            "Remote SSH user for K3s nodes. Defaults to the user that invoked "
            "sudo, or root when SUDO_USER is unavailable."
        ),
    )
    parser.add_argument(
        "--skip-node-distribution",
        action="store_true",
        help=(
            "Configure only this machine; do not copy trust to Ready K3s nodes "
            "or configure Argo Workflows."
        ),
    )
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    argo_hostname = configured_argo_hostname()

    if os.geteuid() != 0:
        print(
            "ERROR: this script must run as root because it updates the "
            "system CA store and Chromium machine policy.",
            file=sys.stderr,
        )
        return 1

    required_commands = ["openssl", "update-ca-certificates"]
    if not args.skip_node_distribution:
        required_commands.extend(["ssh", "scp"])
    for required in required_commands:
        if shutil.which(required) is None:
            print(
                f"ERROR: required command '{required}' was not found.",
                file=sys.stderr,
            )
            return 1

    kubectl = choose_kubectl(args.kubectl)
    namespace_filter = set(args.namespace) if args.namespace else None

    try:
        ingresses = discover_ingresses(kubectl, namespace_filter)
    except (CommandError, json.JSONDecodeError) as exc:
        print(f"ERROR: unable to query Kubernetes: {exc}", file=sys.stderr)
        return 1

    if not ingresses:
        print("No Kubernetes Ingress resources were found.")
        return 0

    try:
        registry_hosts = discover_sysadmin_registry_hosts(
            ingresses, args.registry_host
        )
        nodes = [] if args.skip_node_distribution else ready_k3s_nodes(kubectl)
        ssh_user = validate_ssh_user(
            args.ssh_user or os.environ.get("SUDO_USER") or "root"
        )
    except (CommandError, json.JSONDecodeError) as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 1

    print("\nSysadmin-service registry trust hosts:")
    for registry_host in registry_hosts:
        print(f"  {registry_host}")

    discovered_fps: set[str] = set()

    for ingress in ingresses:
        namespace = ingress["namespace"]
        ingress_name = ingress["name"]

        print(f"\n[{namespace}/{ingress_name}]")

        # 1. Read any explicit TLS Secrets referenced by the Ingress.
        for secret_name in sorted(ingress["secrets"]):
            try:
                secret = kubectl_json(
                    kubectl,
                    [
                        "get",
                        "secret",
                        secret_name,
                        "-n",
                        namespace,
                        "-o",
                        "json",
                    ],
                )
            except (CommandError, json.JSONDecodeError) as exc:
                print(f"  Secret {secret_name}: unavailable ({exc})")
                continue

            try:
                anchors, source = candidate_from_secret(secret)
            except Exception as exc:
                print(f"  Secret {secret_name}: invalid certificate ({exc})")
                continue

            if not anchors:
                print(f"  Secret {secret_name}: {source}")
                continue

            for index, cert in enumerate(anchors):
                fp = fingerprint(cert)
                discovered_fps.add(fp)
                path = write_cert(
                    f"{namespace}-{ingress_name}-secret-{secret_name}-{index}",
                    cert,
                )
                print(f"  Secret {secret_name}: trusted {cert_subject(cert)}")
                print(f"    -> {path}")

        # 2. Independently inspect the certificate clients actually see.
        for host in ingress["hosts"]:
            print(f"  Endpoint https://{host}:443")

            chain = fetch_endpoint_chain(host)
            if not chain:
                print("    WARNING: could not retrieve a TLS certificate chain")
                continue

            leaf = chain[0]
            print(f"    served: {cert_subject(leaf)}")
            dates = cert_dates(leaf)
            if dates:
                print(f"    {dates}")

            trust_chain = choose_trust_chain(chain)
            if not trust_chain:
                print(
                    "    WARNING: endpoint chain contains no self-signed/private "
                    "CA certificate that can safely be installed as a trust anchor"
                )
                continue

            for index, cert in enumerate(trust_chain):
                fp = fingerprint(cert)
                discovered_fps.add(fp)
                path = write_cert(
                    f"{namespace}-{ingress_name}-endpoint-{host}-{index}",
                    cert,
                )
                print(f"    trusted chain certificate: {cert_subject(cert)}")
                print(f"      -> {path}")

    managed = all_managed_certs()

    if not managed:
        print(
            "\nERROR: no usable CA/self-signed certificates were discovered.",
            file=sys.stderr,
        )
        return 1

    try:
        bundle_path = write_ca_bundle(managed)
        registry_path, registry_backup = merge_k3s_registry_config(registry_hosts)
    except (CommandError, OSError) as exc:
        print(f"ERROR: unable to configure K3s registry trust: {exc}", file=sys.stderr)
        return 1

    print(f"\nK3s CA bundle: {bundle_path}")
    print(f"K3s registry configuration: {registry_path}")
    if registry_backup:
        print(f"Previous registry configuration: {registry_backup}")

    print("\nUpdating Debian/Ubuntu system trust store...")
    try:
        proc = run(["update-ca-certificates"])
        output = proc.stdout.decode(errors="replace").strip()
        if output:
            print(output)
    except CommandError as exc:
        print(f"ERROR: update-ca-certificates failed:\n{exc}", file=sys.stderr)
        return 1

    print("\nUpdating Chromium machine-wide CA policy...")
    policy_paths = write_chromium_policy(managed)

    for path in policy_paths:
        print(f"  {path}")

    print(
        f"\nInstalled {len(managed)} unique trust certificate(s)."
    )
    print(
        "\nChromium: open chrome://policy and click 'Reload policies', "
        "or completely restart Chromium."
    )
    print(
        "The policy should appear as 'CACertificates'."
    )

    if nodes:
        print(f"\nDistributing trust to {len(nodes)} Ready K3s node(s) as {ssh_user}...")
        try:
            distributed = distribute_to_ready_nodes(
                nodes, ssh_user, registry_path, bundle_path
            )
        except (CommandError, OSError) as exc:
            print(f"ERROR: node distribution failed: {exc}", file=sys.stderr)
            return 1
        print(f"Updated {distributed} remote K3s node(s).")

    if argo_hostname and args.skip_node_distribution:
        print(
            "\nArgo trust: node distribution was skipped, so workflow trust "
            "injection was also skipped."
        )
    elif argo_hostname:
        print("\nChecking Argo Workflows trust integration...")
        try:
            inject_argo_workflow_trust(
                kubectl,
                ingresses,
                argo_hostname,
                managed,
            )
        except (CommandError, json.JSONDecodeError, OSError) as exc:
            print(
                f"ERROR: could not configure Argo workflow trust: {exc}",
                file=sys.stderr,
            )
            return 1
    else:
        print("\nArgo trust: ARGO_HOSTNAME is not configured; skipping.")

    try:
        local_service = restart_local_k3s()
    except CommandError as exc:
        print(f"ERROR: could not restart local K3s: {exc}", file=sys.stderr)
        return 1
    if local_service:
        print(f"Restarted local {local_service} service.")
    else:
        print("No local K3s service was found; only remote K3s nodes were restarted.")

    return 0


if __name__ == "__main__":
    raise SystemExit(main())
