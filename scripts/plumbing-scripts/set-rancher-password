#!/usr/bin/env python3
import argparse
import os
from urllib.parse import quote

from platform_common import (
    DEFAULT_RANCHER_HOST, current_username, normalize_url, rancher_headers,
    request_json, secure_prompt, require_hostname,
)

def main():
    p = argparse.ArgumentParser(description="Update a local Rancher user's password.")
    p.add_argument("-u", "--username", default=current_username())
    p.add_argument("-H", "--hostname", default=DEFAULT_RANCHER_HOST)
    p.add_argument("--token", default=os.environ.get("RANCHER_TOKEN"))
    args = p.parse_args()
    args.hostname = require_hostname(args.hostname, "RANCHER_HOSTNAME")

    token = args.token or secure_prompt("Rancher admin API token: ")
    password = os.environ.get("USER_PASSWORD") or secure_prompt(f"New Rancher password for {args.username}: ")
    base = normalize_url(args.hostname)
    headers = rancher_headers(token)
    verify = False

    users = request_json("GET", f"{base}/apis/management.cattle.io/v3/users",
                         headers=headers, verify=verify)
    user = next((x for x in users.get("items", []) if x.get("username") == args.username), None)
    if not user:
        raise SystemExit(f"Rancher user {args.username!r} was not found.")

    user_id = user["metadata"]["name"]

    # Local Rancher passwords are stored in Secrets in cattle-local-user-passwords.
    # Rancher's webhook converts stringData.password to its stored password representation.
    patch_headers = dict(headers)
    patch_headers["Content-Type"] = "application/merge-patch+json"
    request_json(
        "PATCH",
        f"{base}/api/v1/namespaces/cattle-local-user-passwords/secrets/{quote(user_id)}",
        headers=patch_headers,
        json_body={"stringData": {"password": password}},
        verify=verify,
    )
    print(f"Updated Rancher password for {args.username}.")

if __name__ == "__main__":
    main()
