#!/usr/bin/env python3
import argparse
import os
import re
from pathlib import Path
from string import Template

from platform_common import determine_username, die, get_user, require_root, run


MANIFEST_TEMPLATE = (
    Path(__file__).resolve().parents[2]
    / "argo"
    / "argo-workflow-runner.yaml.template"
)


def validate_namespace(namespace: str) -> str:
    if not re.fullmatch(r"[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?", namespace):
        die(
            "Namespace must be a lowercase Kubernetes DNS label containing only "
            "letters, digits, and '-' (max 63 characters)."
        )
    return namespace


def kubectl(args, *, check=True, capture=False, input_data=None):
    env = os.environ.copy()
    if "KUBECONFIG" not in env and Path("/etc/rancher/k3s/k3s.yaml").exists():
        env["KUBECONFIG"] = "/etc/rancher/k3s/k3s.yaml"
    return run(
        ["kubectl", *args],
        check=check,
        capture=capture,
        env=env,
        input_data=input_data,
    )


def main():
    parser = argparse.ArgumentParser(
        description="Install an Argo workflow runner service account in a user's namespace."
    )
    parser.add_argument("-u", "--username", required=True)
    parser.add_argument("-n", "--namespace", required=True)
    args = parser.parse_args()

    require_root()
    username = determine_username(args.username)
    get_user(username)
    namespace = validate_namespace(args.namespace)

    namespace_result = kubectl(
        ["get", "namespace", namespace], check=False, capture=True
    )
    if namespace_result.returncode != 0:
        die(
            f"Namespace '{namespace}' does not exist. Create the user's namespace "
            "before installing its Argo workflow runner."
        )

    try:
        manifest_source = MANIFEST_TEMPLATE.read_text()
    except FileNotFoundError:
        die(f"Argo workflow runner template not found: {MANIFEST_TEMPLATE}")

    manifest = Template(manifest_source).substitute(
        USERNAME=username,
        NAMESPACE=namespace,
    )
    kubectl(["apply", "-f", "-"], input_data=manifest)

    runner = "argo-workflow-runner"
    print(f"Installed service account: {namespace}/{runner}")
    print("Granted create and patch access to WorkflowTaskResult resources.")
    print("Granted create, get, and delete access to namespaced Service resources.")
    print("Granted the workflow runner admin access within its user namespace.")
    print(
        "Granted the user's namespace service account read access to "
        "ClusterWorkflowTemplate resources."
    )


if __name__ == "__main__":
    main()
