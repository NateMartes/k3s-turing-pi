#!/usr/bin/env python3
import argparse
import os
from urllib.parse import quote, urlencode

from platform_common import (
    DEFAULT_HARBOR_HOST, current_username, get_user, harbor_headers,
    normalize_url, request_json, require_hostname, require_root, secure_prompt,
    validate_password,
)


PROJECT_ADMIN_ROLE_ID = 1
DEFAULT_STORAGE_QUOTA_BYTES = 10 * 1024 * 1024 * 1024


def main():
    """Create a local Harbor user and a private project named after its K3s namespace."""
    require_root()
    parser = argparse.ArgumentParser(
        description="Create a local Harbor user and a private <user>-namespace project."
    )
    parser.add_argument("-u", "--username", default=current_username())
    parser.add_argument("-H", "--hostname", default=DEFAULT_HARBOR_HOST)
    parser.add_argument(
        "-p", "--password", default=None,
        help="New Harbor user password. Omit to use USER_PASSWORD or prompt securely.",
    )
    parser.add_argument(
        "--email", default=None,
        help="Email for a newly created Harbor user. Defaults to <user>@local.invalid.",
    )
    parser.add_argument(
        "--storage-quota-bytes", type=int, default=DEFAULT_STORAGE_QUOTA_BYTES,
        help="Harbor project storage quota in bytes. Default: 10737418240 (10GiB).",
    )
    parser.add_argument(
        "--admin-username", default=os.environ.get("HARBOR_ADMIN_USERNAME", "admin"),
        help="Harbor administrator username. Defaults to admin or HARBOR_ADMIN_USERNAME.",
    )
    parser.add_argument(
        "--admin-password", default=os.environ.get("HARBOR_ADMIN_PASSWORD"),
        help="Harbor administrator password. Prefer HARBOR_ADMIN_PASSWORD.",
    )
    args = parser.parse_args()
    args.hostname = require_hostname(args.hostname, "HARBOR_HOSTNAME")
    if args.storage_quota_bytes <= 0:
        parser.error("--storage-quota-bytes must be greater than zero")

    # Match K3s namespace provisioning: only provision resources for a local user.
    get_user(args.username)
    password = args.password or os.environ.get("USER_PASSWORD")
    if not password:
        password = secure_prompt(f"New Harbor password for {args.username}: ")
    validate_password(password)
    admin_password = args.admin_password or secure_prompt(
        f"Harbor administrator password for {args.admin_username}: "
    )

    base = normalize_url(args.hostname)
    headers = harbor_headers(args.admin_username, admin_password)
    verify = False
    username = args.username
    project_name = f"{username}-namespace"

    users = request_json(
        "GET", f"{base}/api/v2.0/users?{urlencode({'username': username})}",
        headers=headers, verify=verify,
    )
    user = next((item for item in users if item.get("username") == username), None)
    if not user:
        user = request_json(
            "POST", f"{base}/api/v2.0/users", headers=headers,
            json_body={
                "username": username,
                "password": password,
                "email": args.email or f"{username}@local.invalid",
                "realname": username,
            },
            verify=verify,
        )
        print(f"Created Harbor user {username}.")
    else:
        print(f"Harbor user {username} already exists; password was not changed.")

    projects = request_json(
        "GET", f"{base}/api/v2.0/projects?{urlencode({'name': project_name})}",
        headers=headers, verify=verify,
    )
    project = next((item for item in projects if item.get("name") == project_name), None)
    if project and str(project.get("metadata", {}).get("public", "false")).lower() == "true":
        raise SystemExit(
            f"Harbor project {project_name!r} already exists but is public; refusing to use it as a private namespace."
        )
    if not project:
        request_json(
            "POST", f"{base}/api/v2.0/projects", headers=headers,
            json_body={
                "project_name": project_name,
                "metadata": {"public": "false"},
            },
            verify=verify,
        )
        print(f"Created private Harbor namespace project {project_name}.")
        projects = request_json(
            "GET", f"{base}/api/v2.0/projects?{urlencode({'name': project_name})}",
            headers=headers, verify=verify,
        )
        project = next((item for item in projects if item.get("name") == project_name), None)
    if not project or project.get("project_id") is None:
        raise SystemExit(f"Harbor did not return a project ID for {project_name!r}.")

    quota_response = request_json(
        "GET",
        f"{base}/api/v2.0/quotas?{urlencode({'reference': project['project_id']})}",
        headers=headers,
        verify=verify,
    )
    quotas = (
        quota_response.get("items", [quota_response])
        if isinstance(quota_response, dict)
        else quota_response
    )
    quota = next(
        (
            item for item in quotas
            if str(item.get("ref", {}).get("id")) == str(project["project_id"])
        ),
        None,
    )
    if not quota or quota.get("id") is None:
        raise SystemExit(f"Harbor did not return a storage quota for {project_name!r}.")
    request_json(
        "PUT", f"{base}/api/v2.0/quotas/{quote(str(quota['id']), safe='')}",
        headers=headers,
        json_body={"hard": {"storage": args.storage_quota_bytes}},
        verify=verify,
    )
    print(
        f"Set Harbor storage quota for {project_name}: "
        f"{args.storage_quota_bytes} bytes."
    )

    members = request_json(
        "GET", f"{base}/api/v2.0/projects/{quote(project_name, safe='')}/members",
        headers=headers, verify=verify,
    )
    has_membership = any(
        member.get("member_user", {}).get("username") == username for member in members
    )
    if not has_membership:
        request_json(
            "POST", f"{base}/api/v2.0/projects/{quote(project_name, safe='')}/members",
            headers=headers,
            json_body={
                "role_id": PROJECT_ADMIN_ROLE_ID,
                "member_user": {"username": username},
            },
            verify=verify,
        )
        print(f"Granted {username} Project Admin access to {project_name}.")

    print(f"Harbor account ready: {username}")
    print(f"Namespace project: {project_name} (private)")


if __name__ == "__main__":
    main()
