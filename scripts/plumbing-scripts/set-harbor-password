#!/usr/bin/env python3
import argparse
import os
from urllib.parse import quote, urlencode

from platform_common import (
    DEFAULT_HARBOR_HOST, current_username, harbor_headers, normalize_url,
    request_json, require_hostname, require_root, secure_prompt,
    validate_password,
)


def main():
    require_root()
    parser = argparse.ArgumentParser(
        description="Update a database-authenticated Harbor user's password."
    )
    parser.add_argument("-u", "--username", default=current_username())
    parser.add_argument("-H", "--hostname", default=DEFAULT_HARBOR_HOST)
    parser.add_argument(
        "--admin-username", default=os.environ.get("HARBOR_ADMIN_USERNAME", "admin"),
    )
    parser.add_argument(
        "--admin-password", default=os.environ.get("HARBOR_ADMIN_PASSWORD"),
        help="Harbor administrator password. Prefer HARBOR_ADMIN_PASSWORD.",
    )
    args = parser.parse_args()
    args.hostname = require_hostname(args.hostname, "HARBOR_HOSTNAME")

    password = os.environ.get("USER_PASSWORD") or secure_prompt(
        f"New Harbor password for {args.username}: "
    )
    validate_password(password)
    admin_password = args.admin_password or secure_prompt(
        f"Harbor administrator password for {args.admin_username}: "
    )

    base = normalize_url(args.hostname)
    headers = harbor_headers(args.admin_username, admin_password)
    users = request_json(
        "GET",
        f"{base}/api/v2.0/users?{urlencode({'username': args.username})}",
        headers=headers,
        verify=False,
    )
    user = next(
        (item for item in users if item.get("username") == args.username),
        None,
    )
    if not user:
        raise SystemExit(f"Harbor user {args.username!r} was not found.")
    user_id = user.get("user_id")
    if user_id is None:
        raise SystemExit(f"Harbor did not return a user ID for {args.username!r}.")

    request_json(
        "PUT",
        f"{base}/api/v2.0/users/{quote(str(user_id), safe='')}/password",
        headers=headers,
        json_body={"new_password": password},
        verify=False,
    )
    print(f"Updated Harbor password for {args.username}.")


if __name__ == "__main__":
    main()
