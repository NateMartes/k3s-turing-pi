#!/usr/bin/env python3
import argparse
import os
from pathlib import Path

from platform_common import determine_username, get_user, require_root, run
from resource_quantity import resource_quantity


def kubectl(args, *, input_data=None):
    env = os.environ.copy()
    if "KUBECONFIG" not in env and Path("/etc/rancher/k3s/k3s.yaml").exists():
        env["KUBECONFIG"] = "/etc/rancher/k3s/k3s.yaml"
    return run(["kubectl", *args], env=env, input_data=input_data)


def main():
    parser = argparse.ArgumentParser(description="Update a user's K3s namespace quota.")
    parser.add_argument("-u", "--username", default=None)
    parser.add_argument("--cpu-quota", type=resource_quantity, required=True)
    parser.add_argument("--memory-quota", type=resource_quantity, required=True)
    parser.add_argument("--storage-quota", type=resource_quantity, required=True)
    args = parser.parse_args()

    require_root()
    username = determine_username(args.username)
    get_user(username)
    namespace = f"{username}-namespace"
    quota = f"""apiVersion: v1
kind: ResourceQuota
metadata:
  name: {username}-namespace-quota
  namespace: {namespace}
spec:
  hard:
    requests.cpu: {args.cpu_quota}
    limits.cpu: {args.cpu_quota}
    requests.memory: {args.memory_quota}
    limits.memory: {args.memory_quota}
    requests.storage: {args.storage_quota}
    requests.ephemeral-storage: {args.storage_quota}
    limits.ephemeral-storage: {args.storage_quota}
"""
    kubectl(["apply", "-f", "-"], input_data=quota)
    print(
        f"Updated {namespace} quota: CPU {args.cpu_quota}, "
        f"memory {args.memory_quota}, storage {args.storage_quota}."
    )


if __name__ == "__main__":
    main()
