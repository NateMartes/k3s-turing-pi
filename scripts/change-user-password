#!/usr/bin/env python3
import argparse
import getpass
import os

from user_common import (
    DEFAULT_PORTAINER_HOST, DEFAULT_RANCHER_HOST, die, load_state, require_root,
    run, run_plumbing, user_exists, validate_username, DEFAULT_PORTAINER_API_KEY,
    DEFAULT_RANCHER_API_KEY, require_hostname,
)

def main():
    p = argparse.ArgumentParser(description="Change a user's Linux, Rancher, and Portainer passwords.")
    p.add_argument("-u", "--username", required=True)
    args = p.parse_args()

    require_root()
    username = validate_username(args.username)
    if not user_exists(username):
        die(f"Linux user {username!r} does not exist.")

    password = getpass.getpass("New password: ")
    confirm = getpass.getpass("Retype new password: ")
    if password != confirm:
        die("Passwords do not match.")
    if not password:
        die("Password cannot be empty.")

    state = load_state(username)
    rancher_host = require_hostname(
        state.get("rancher_host") or DEFAULT_RANCHER_HOST,
        "RANCHER_HOSTNAME",
        "a rancher_host value in the user's state file",
    )
    portainer_host = require_hostname(
        state.get("portainer_host") or DEFAULT_PORTAINER_HOST,
        "PORTAINER_HOSTNAME",
        "a portainer_host value in the user's state file",
    )
    env = {
            "USER_PASSWORD": password, 
            "RANCHER_TOKEN": DEFAULT_RANCHER_API_KEY, 
            "PORTAINER_API_KEY": DEFAULT_PORTAINER_API_KEY
    }

    failures = []

    # Update the external accounts first; Linux is updated last.
    try:
        args_r = ["-u", username, "-H", rancher_host]
        run_plumbing("set-rancher-password", args_r, extra_env=env)
    except Exception as exc:
        failures.append(("Rancher", str(exc)))

    try:
        # Portainer does not have an admin password reset, so just
        # Blow up the users account... we really are only providing
        # A UI for docker with this anyways...
        args_p = ["-u", username, "-H", portainer_host]
        run_plumbing("uninstall-portainer-account", args_p, extra_env=env)
    except Exception as exc:
        failures.append(("Portainer", str(exc)))

    try:
        args_p = ["-u", username, "-H", portainer_host]
        run_plumbing("install-portainer-account", args_p, extra_env=env)
    except Exception as exc:
        failures.append(("Portainer", str(exc)))

    if failures:
        print("\nLinux password was NOT changed because one or more external password updates failed.")
        for service, error in failures:
            print(f"- {service}: {error}")
        raise SystemExit(1)

    run(["chpasswd"], input_data=f"{username}:{password}\n")
    print(f"Updated Linux, Rancher, and Portainer passwords for {username}.")

if __name__ == "__main__":
    main()
