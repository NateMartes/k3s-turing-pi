#!/usr/bin/env python3
import argparse
import getpass
import os

from user_common import (
    DEFAULT_HARBOR_HOST, DEFAULT_PORTAINER_HOST, DEFAULT_RANCHER_HOST,
    die, load_state, require_root,
    run, run_plumbing, user_exists, validate_username, DEFAULT_PORTAINER_API_KEY,
    DEFAULT_RANCHER_API_KEY, require_hostname, validate_password,
    print_unverified_https_notice, DEFAULT_HARBOR_ADMIN_PASSWORD,
)

def main():
    p = argparse.ArgumentParser(
        description="Change a user's Linux password and passwords for managed service accounts."
    )
    p.add_argument("-u", "--username", required=True)
    args = p.parse_args()

    require_root()
    username = validate_username(args.username)
    if not user_exists(username):
        die(f"Linux user {username!r} does not exist.")

    password = getpass.getpass("New password: ")
    confirm = getpass.getpass("Retype new password: ")
    if password != confirm:
        die("Passwords do not match.")
    validate_password(password)

    state = load_state(username)
    # Missing flags are treated as managed for compatibility with older state files.
    def was_created(key: str) -> bool:
        return state.get(key) is not False

    harbor_host = None
    rancher_host = None
    portainer_host = None
    https_services = []
    if was_created("harbor_account"):
        harbor_host = require_hostname(
            state.get("harbor_host") or DEFAULT_HARBOR_HOST,
            "HARBOR_HOSTNAME",
            "a harbor_host value in the user's state file",
        )
        https_services.append(("Harbor", harbor_host))
    if was_created("rancher_account"):
        rancher_host = require_hostname(
            state.get("rancher_host") or DEFAULT_RANCHER_HOST,
            "RANCHER_HOSTNAME",
            "a rancher_host value in the user's state file",
        )
        https_services.append(("Rancher", rancher_host))
    if was_created("portainer_account"):
        portainer_host = require_hostname(
            state.get("portainer_host") or DEFAULT_PORTAINER_HOST,
            "PORTAINER_HOSTNAME",
            "a portainer_host value in the user's state file",
        )
        https_services.append(("Portainer", portainer_host))
    print_unverified_https_notice(https_services)
    env = {"USER_PASSWORD": password}
    if DEFAULT_HARBOR_ADMIN_PASSWORD:
        env["HARBOR_ADMIN_PASSWORD"] = DEFAULT_HARBOR_ADMIN_PASSWORD
    if DEFAULT_RANCHER_API_KEY:
        env["RANCHER_TOKEN"] = DEFAULT_RANCHER_API_KEY
    if DEFAULT_PORTAINER_API_KEY:
        env["PORTAINER_API_KEY"] = DEFAULT_PORTAINER_API_KEY

    failures = []

    # Update the external accounts first; Linux is updated last.
    if was_created("harbor_account"):
        try:
            args_h = ["-u", username, "-H", harbor_host]
            run_plumbing("set-harbor-password", args_h, extra_env=env)
        except Exception as exc:
            failures.append(("Harbor", str(exc)))

    if was_created("rancher_account"):
        try:
            args_r = ["-u", username, "-H", rancher_host]
            run_plumbing("set-rancher-password", args_r, extra_env=env)
        except Exception as exc:
            failures.append(("Rancher", str(exc)))

    if was_created("portainer_account"):
        try:
            # Portainer does not have an admin password reset, so recreate the account.
            args_p = ["-u", username, "-H", portainer_host]
            run_plumbing("uninstall-portainer-account", args_p, extra_env=env)
        except Exception as exc:
            failures.append(("Portainer", str(exc)))

        try:
            args_p = ["-u", username, "-H", portainer_host]
            run_plumbing("install-portainer-account", args_p, extra_env=env)
        except Exception as exc:
            failures.append(("Portainer", str(exc)))

    if failures:
        print("\nLinux password was NOT changed because one or more external password updates failed.")
        for service, error in failures:
            print(f"- {service}: {error}")
        raise SystemExit(1)

    run(["chpasswd"], input_data=f"{username}:{password}\n")
    updated = ["Linux"]
    if was_created("harbor_account"):
        updated.append("Harbor")
    if was_created("rancher_account"):
        updated.append("Rancher")
    if was_created("portainer_account"):
        updated.append("Portainer")
    print(f"Updated {', '.join(updated)} passwords for {username}.")

if __name__ == "__main__":
    main()
