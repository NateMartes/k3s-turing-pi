{
  "uid": "jihwija-cluster-health",
  "title": "Jihwija / Cluster and node health",
  "tags": ["jihwija", "kubernetes"],
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "type": "stat",
      "title": "Nodes",
      "datasource": {
        "type": "prometheus",
        "uid": "jihwija-mimir"
      },
      "targets": [
        {
          "expr": "count(kube_node_info)",
          "refId": "A"
        }
      ],
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0}
    },
    {
      "type": "stat",
      "title": "Ready nodes",
      "datasource": {
        "type": "prometheus",
        "uid": "jihwija-mimir"
      },
      "targets": [
        {
          "expr": "sum(kube_node_status_condition{condition=\"Ready\",status=\"true\"})",
          "refId": "A"
        }
      ],
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0}
    },
    {
      "type": "stat",
      "title": "Unhealthy Pods",
      "datasource": {
        "type": "prometheus",
        "uid": "jihwija-mimir"
      },
      "targets": [
        {
          "expr": "sum(kube_pod_status_phase{phase=~\"Pending|Failed|Unknown\"})",
          "refId": "A"
        }
      ],
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0}
    }
  ]
}
