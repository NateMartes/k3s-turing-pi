{
  "uid": "jihwija-workloads",
  "title": "Jihwija / Workload status and restarts",
  "tags": ["jihwija", "kubernetes"],
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Desired vs available deployment replicas",
      "datasource": {
        "type": "prometheus",
        "uid": "jihwija-mimir"
      },
      "targets": [
        {
          "expr": "sum by (namespace, deployment) (kube_deployment_spec_replicas)",
          "legendFormat": "desired {{namespace}}/{{deployment}}",
          "refId": "A"
        },
        {
          "expr": "sum by (namespace, deployment) (kube_deployment_status_replicas_available)",
          "legendFormat": "available {{namespace}}/{{deployment}}",
          "refId": "B"
        }
      ],
      "gridPos": {"h": 10, "w": 12, "x": 0, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "Container restarts",
      "datasource": {
        "type": "prometheus",
        "uid": "jihwija-mimir"
      },
      "targets": [
        {
          "expr": "sum by (namespace, pod) (increase(kube_pod_container_status_restarts_total[1h]))",
          "legendFormat": "{{namespace}}/{{pod}}",
          "refId": "A"
        }
      ],
      "gridPos": {"h": 10, "w": 12, "x": 12, "y": 0}
    },
    {
      "type": "table",
      "title": "Pod phases",
      "datasource": {
        "type": "prometheus",
        "uid": "jihwija-mimir"
      },
      "targets": [
        {
          "expr": "sum by (namespace, phase) (kube_pod_status_phase == 1)",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "gridPos": {"h": 10, "w": 24, "x": 0, "y": 10}
    }
  ]
}
